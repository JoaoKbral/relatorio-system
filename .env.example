# Cole aqui a URL do banco de dados do Neon
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Segredo para assinar os tokens de sessão (gere com: openssl rand -base64 32)
SESSION_SECRET=change-this-to-a-random-32-char-secret

# Credenciais de seed (usadas apenas pelo comando db:seed)
SEED_ADMIN_EMAIL="admin@suaigreja.com"
SEED_ADMIN_PASSWORD="senha-do-admin"
SEED_SUPER_ADMIN_EMAIL="super@exemplo.com"
SEED_SUPER_ADMIN_PASSWORD="senha-do-super-admin"

# Dados da igreja inicial criada pelo seed
CHURCH_NAME="Nome da Igreja"
CHURCH_CITY="Cidade – Bairro"
CHURCH_CNPJ="00.000.000/0000-00"
CHURCH_PASTOR="Nome do Pastor Titular"
CHURCH_PRONTUARIO="00000"
